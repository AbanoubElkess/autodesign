{
  "problem_id": "demo_periodic_unit_cell",
  "random_seed": 11,
  "cache_dir": ".autodesign_cache",
  "output_dir": ".autodesign_runs",
  "geometry": {
    "family": "layered_material_grid",
    "grid_shape": [4, 4],
    "unit_cell_size_um": [0.8, 0.8],
    "layer_thickness_um": [0.2, 0.15],
    "periodic_x": true,
    "periodic_y": true,
    "superstrate_material": "Air",
    "substrate_material": "SiO2"
  },
  "material_search_policy": {
    "material_classes": ["dielectric", "pcm"],
    "include_materials": ["SiO2", "SiN", "GST"],
    "exclude_materials": [],
    "max_candidates": 3,
    "prefer_phase_change": true,
    "database": "lumerical"
  },
  "spectral_grid": {
    "wavelength_um": [1.45, 1.55, 1.65],
    "incidence_angles_deg": [0.0],
    "polarizations": ["TE", "TM"]
  },
  "objective": {
    "target_channels": ["T", "phase"],
    "target_response": {
      "T": [
        [0.8, 0.85, 0.9],
        [0.78, 0.82, 0.88]
      ],
      "phase": [
        [0.0, 0.5, 1.0],
        [0.0, 0.45, 0.9]
      ]
    },
    "channel_weights": {
      "T": 1.0,
      "phase": 0.2
    }
  },
  "dataset": {
    "num_samples": 10,
    "train_split": 0.8,
    "dataset_file": "dataset.pt"
  },
  "surrogate": {
    "hidden_channels": 16,
    "epochs": 3,
    "batch_size": 4,
    "learning_rate": 0.001,
    "weight_decay": 0.0001
  },
  "inverse_design": {
    "steps": 10,
    "learning_rate": 0.08,
    "top_k": 2,
    "binarization_weight": 0.01,
    "restarts": 1,
    "temperature": 1.0,
    "validate_with_solver": false,
    "append_refined_to_dataset": true
  },
  "solver": {
    "backend": "lumerical_fdtd",
    "product": "fdtd",
    "python_api_path": "C:\\api\\python",
    "timeout_s": 60
  }
}
